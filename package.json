{
  "name": "agentplus",
  "version": "0.2.0",
  "description": "agent+: route work between coding-agent harnesses (Claude Code, Codex, and any CLI described by a manifest).",
  "keywords": [
    "claude-code",
    "openai-codex",
    "ai-agents",
    "coding-agents",
    "agent-orchestration",
    "multi-agent",
    "developer-tools",
    "git-worktree"
  ],
  "repository": "github:knakul853/claude-codex-bridge",
  "homepage": "https://github.com/knakul853/claude-codex-bridge#readme",
  "bugs": "https://github.com/knakul853/claude-codex-bridge/issues",
  "type": "module",
  "private": true,
  "bin": {
    "agentplus": "./src/cli.ts",
    "claude-codex-bridge": "./src/cli.ts"
  },
  "scripts": {
    "bridge": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && biome check . && bun test",
    "privacy-check": "bun run scripts/privacy-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
